PORT=4000
NODE_ENV=production

# Public frontend URL used in WhatsApp order links.
FRONTEND_BASE_URL=https://your-frontend-public-url.example

# Security
CORS_ORIGIN=https://your-frontend-public-url.example,https://api.your-domain.example
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_SEED_EMAIL=platform-admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-temporary-bootstrap-password
# Optional for API clients that use Authorization: Bearer <token> or x-admin-token.
ADMIN_AUTH_TOKEN=replace-with-a-long-random-admin-token

# Production should keep fallback disabled so checkout fails if no live gateway is configured.
ALLOW_PAYMENT_FALLBACK=false

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=neubar_whatsapp_verify_2025
WHATSAPP_PHONE_NUMBER_ID=1129627703565763
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-or-long-lived-token
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Razorpay webhook verification
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Optional storage overrides
# MENU_FILE=./data/menu.json
# OUTLETS_FILE=./data/outlets.json
# SESSIONS_FILE=./data/sessions.json
# ORDERS_FILE=./data/orders.json
# IMAGE_MANIFEST_FILE=./data/uploaded-images.json
# AUDIT_LOG_FILE=./data/audit-logs.json
# WHATSAPP_EVENTS_FILE=./data/whatsapp-events.json
# UPLOAD_DIR=./data/uploads
